# ---- Servidor ----
PORT=4000
HOST=0.0.0.0
# Secreto para firmar los JWT. CAMBIALO en produccion.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio
# Ruta del archivo SQLite (por defecto ./data/fixi.db)
DB_PATH=./data/fixi.db
# URL publica del server (la usan Mercado Pago y los checkout para volver/notificar).
# Si la dejas vacia se deduce del header Host de cada request (sirve para la demo en red local).
PUBLIC_BASE_URL=

# ---- Pagos ----
# mock (demo, default) | mercadopago
PAYMENT_PROVIDER=mock
# Porcentaje de comision de Fixi
COMMISSION_PERCENT=5

# ---- Mercado Pago (solo si PAYMENT_PROVIDER=mercadopago) ----
# Credenciales de la aplicacion de Fixi en https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta para validar la firma de los webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=
# true para usar el init_point de sandbox (cuentas de prueba)
MP_SANDBOX=false
# Dominio de autorizacion OAuth (Argentina)
MP_AUTH_URL=https://auth.mercadopago.com.ar
