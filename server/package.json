{
  "name": "fixi-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Fixi: marketplace de servicio técnico a domicilio",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "seed": "tsx src/seed-cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
